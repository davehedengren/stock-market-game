run = "npm start"
entrypoint = "server.js"
modules = ["nodejs-20:v8-20230920-bd784b9"]

hidden = [".config", "package-lock.json"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "npm start"]

[[ports]]
localPort = 3000
externalPort = 80

[env]
PATH = "/home/runner/$REPL_SLUG/node_modules/.bin:$PATH"
